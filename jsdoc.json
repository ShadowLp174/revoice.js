{
  "opts": {
    "template": "node_modules/better-docs",
    "destination": "./docs",
    "readme": "README.md"
  },
  "source": {
    "include": ["./src", "./src/engine", "./src/dsp", "./src/adapters"],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_|V1\\.js$"
  },
  "sourceType": "module",
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc","closure"]
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "plugins": ["plugins/markdown"],
  "recurseDepth": 10
}
