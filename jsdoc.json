{
  "opts": {
    "template": "node_modules/clean-jsdoc-theme/dist",
    "destination": "./docs",
    "readme": "README-docs.md",
    "tutorials": "./tutorials",
    "siteName": "Revoice.js Documentation",
    "theme_opts": {
      "base_url": "/revoice.js/"
    }
  },
  "cleanJsdocTheme": {
    "basePath": "/revoice.js/"
  },
  "source": {
    "include": ["./src", "./src/engine", "./src/dsp", "./src/adapters"],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_|V1\\.js$"
  },
  "sourceType": "module",
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc","closure"]
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "plugins": ["plugins/markdown", "node_modules/jsdoc-plugin-typescript"],
  "recurseDepth": 10
}
